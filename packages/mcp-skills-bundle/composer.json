{
    "name": "emagma/mcp-skills-bundle",
    "type": "symfony-bundle",
    "description": "The skills of a business an MCP server hands to its clients: SKILL.md folders (Agent Skills), listed for the caller's grants and served as embedded resources for the client to install.",
    "keywords": [
        "mcp",
        "skills",
        "symfony-bundle"
    ],
    "homepage": "https://github.com/emagma/mcp-skills-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Emagma",
            "homepage": "https://www.emagma.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/emagma/mcp-skills-bundle/issues",
        "source": "https://github.com/emagma/mcp-skills-bundle"
    },
    "require": {
        "emagma/mcp-core-bundle": "^0.1",
        "mcp/sdk": "^0.9",
        "php": ">=8.4",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/finder": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1",
        "symfony/yaml": "^7.4 || ^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5.45",
        "sylius-labs/coding-standard": "^4.5",
        "symfony/filesystem": "^7.4 || ^8.1",
        "symfony/framework-bundle": "^7.4 || ^8.1",
        "symfony/mcp-bundle": "^0.15"
    },
    "autoload": {
        "psr-4": {
            "Emagma\\McpSkillsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emagma\\McpSkillsBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
