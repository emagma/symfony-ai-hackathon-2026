<?xml version="1.0" encoding="UTF-8" ?>
<!--
  `mcp:country:lean` group - exposed to list_countries via Prefer: respond-for=lean.
  Strips out the provinces collection (large for some countries).
-->
<serializer xmlns="http://symfony.com/schema/dic/serializer-mapping"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://symfony.com/schema/dic/serializer-mapping
                                https://symfony.com/schema/dic/serializer-mapping/serializer-mapping-1.0.xsd">

    <class name="Sylius\Component\Addressing\Model\Country">
        <attribute name="code">
            <group>mcp:country:lean</group>
        </attribute>
        <attribute name="name">
            <group>mcp:country:lean</group>
        </attribute>
        <attribute name="enabled">
            <group>mcp:country:lean</group>
        </attribute>
    </class>

</serializer>
