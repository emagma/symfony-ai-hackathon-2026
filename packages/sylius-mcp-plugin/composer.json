{
    "name": "emagma/sylius-mcp-plugin",
    "type": "sylius-plugin",
    "description": "What a Sylius shop needs so that the Emagma MCP server can drive it: lean API payloads, the filters the MCP tools rely on and the service account the server authenticates with.",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "mcp"
    ],
    "homepage": "https://github.com/emagma/sylius-mcp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Emagma",
            "homepage": "https://www.emagma.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/emagma/sylius-mcp-plugin/issues",
        "source": "https://github.com/emagma/sylius-mcp-plugin"
    },
    "require": {
        "php": "^8.3",
        "api-platform/doctrine-orm": "^4.0 || ^5.0",
        "api-platform/metadata": "^4.0 || ^5.0",
        "api-platform/state": "^4.0 || ^5.0",
        "composer-runtime-api": "^2.2",
        "doctrine/orm": "^2.18 || ^3.0",
        "psr/log": "^2.0 || ^3.0",
        "sylius/sylius": "^2.2 <2.4",
        "symfony/config": "^6.4 || ^7.4 || ^8.1",
        "symfony/console": "^6.4 || ^7.4 || ^8.1",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.1",
        "symfony/http-foundation": "^6.4 || ^7.4 || ^8.1",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.1",
        "symfony/security-bundle": "^6.4 || ^7.4 || ^8.1",
        "symfony/serializer": "^6.4 || ^7.4 || ^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5.45",
        "sylius-labs/coding-standard": "^4.5"
    },
    "autoload": {
        "psr-4": {
            "Emagma\\SyliusMcpPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emagma\\SyliusMcpPlugin\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
