{
    "name": "emagma/mcp-sylius-events-bundle",
    "type": "symfony-bundle",
    "description": "What happens in a Sylius shop, received from emagma/sylius-mcp-event-plugin as signed webhooks and kept as a journal that background agents read.",
    "keywords": [
        "mcp",
        "sylius",
        "webhook",
        "symfony-bundle"
    ],
    "homepage": "https://github.com/emagma/mcp-sylius-events-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Emagma",
            "homepage": "https://www.emagma.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/emagma/mcp-sylius-events-bundle/issues",
        "source": "https://github.com/emagma/mcp-sylius-events-bundle"
    },
    "require": {
        "php": ">=8.4",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/framework-bundle": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1",
        "symfony/remote-event": "^7.4 || ^8.1",
        "symfony/webhook": "^7.4 || ^8.1"
    },
    "require-dev": {
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5.45",
        "psr/log": "^2.0 || ^3.0",
        "sylius-labs/coding-standard": "^4.5",
        "symfony/clock": "^7.4 || ^8.1",
        "symfony/event-dispatcher": "^7.4 || ^8.1",
        "symfony/http-client": "^7.4 || ^8.1"
    },
    "suggest": {
        "doctrine/doctrine-migrations-bundle": "To create the journal table with the bundle's migration"
    },
    "autoload": {
        "psr-4": {
            "Emagma\\McpSyliusEventsBundle\\": "src/",
            "Emagma\\McpSyliusEventsBundle\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emagma\\McpSyliusEventsBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
