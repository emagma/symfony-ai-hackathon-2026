{
    "name": "emagma/sylius-mcp-event-plugin",
    "type": "sylius-plugin",
    "description": "The shop half of emagma/mcp-sylius-events-bundle: relays what happens in the shop (a customer account is created) to the Emagma MCP server as signed webhooks, sent asynchronously.",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "mcp",
        "webhook"
    ],
    "homepage": "https://github.com/emagma/sylius-mcp-event-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Emagma",
            "homepage": "https://www.emagma.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/emagma/sylius-mcp-event-plugin/issues",
        "source": "https://github.com/emagma/sylius-mcp-event-plugin"
    },
    "require": {
        "php": "^8.3",
        "doctrine/orm": "^2.18 || ^3.0",
        "sylius/sylius": "^1.14 || ^2.2",
        "symfony/config": "^6.4 || ^7.4 || ^8.1",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.1",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.1",
        "symfony/messenger": "^6.4 || ^7.4 || ^8.1",
        "symfony/remote-event": "^6.4 || ^7.4 || ^8.1",
        "symfony/uid": "^6.4 || ^7.4 || ^8.1",
        "symfony/webhook": "^6.4 || ^7.4 || ^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5.45",
        "sylius-labs/coding-standard": "^4.5"
    },
    "autoload": {
        "psr-4": {
            "Emagma\\SyliusMcpEventPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emagma\\SyliusMcpEventPlugin\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "symfony/flex": false,
            "symfony/runtime": false
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
