{
    "name": "emagma/symfony-ai-hackathon-2026-bundle",
    "type": "symfony-bundle",
    "description": "The guided tour of the Symfony AI & MCP Hackathon 2026 for an MCP server built on the emagma bundles: nine demos served to the chat, a fraud checker background agent and a product translation task.",
    "keywords": [
        "mcp",
        "symfony-ai",
        "hackathon",
        "symfony-bundle"
    ],
    "homepage": "https://github.com/emagma/symfony-ai-hackathon-2026-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Emagma",
            "homepage": "https://www.emagma.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/emagma/symfony-ai-hackathon-2026-bundle/issues",
        "source": "https://github.com/emagma/symfony-ai-hackathon-2026-bundle"
    },
    "require": {
        "emagma/mcp-agents-bundle": "^0.1",
        "emagma/mcp-core-bundle": "^0.1",
        "emagma/mcp-sylius-bundle": "^0.1",
        "emagma/mcp-sylius-events-bundle": "^0.1",
        "emagma/mcp-tasks-bundle": "^0.1",
        "mcp/sdk": "^0.9",
        "php": ">=8.4",
        "psr/clock": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/ai-agent": "^0.15",
        "symfony/ai-platform": "^0.15",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/console": "^7.4 || ^8.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/finder": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1",
        "symfony/lock": "^7.4 || ^8.1",
        "symfony/messenger": "^7.4 || ^8.1",
        "symfony/yaml": "^7.4 || ^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5.45",
        "sylius-labs/coding-standard": "^4.5",
        "symfony/clock": "^7.4 || ^8.1",
        "symfony/filesystem": "^7.4 || ^8.1",
        "symfony/framework-bundle": "^7.4 || ^8.1",
        "symfony/mcp-bundle": "^0.15"
    },
    "autoload": {
        "psr-4": {
            "Emagma\\SymfonyAiHackathon2026Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emagma\\SymfonyAiHackathon2026Bundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
