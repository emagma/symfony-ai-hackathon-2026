# Per-app dependencies and runtime state
/apps/*/vendor/
/apps/*/var/
/apps/*/node_modules/
/apps/*/public/build/
/apps/*/public/media/
/apps/*/public/assets/
/apps/*/.env.local
/apps/*/.env.*.local
/apps/*/.phpunit.cache/
/apps/*/.phpunit.result.cache
/packages/*/vendor/
/packages/*/.phpunit.cache/
/packages/*/.phpunit.result.cache

/.idea/
/compose.override.yml

# Emagma - resolved INI and Docker env (contain secrets)
/.project.local.ini
/docker/.env
/.castor/.env
