{% set running = hookable_metadata.context.running %}

<div class="page-body">
    <div class="container-xl">
        <div class="row row-cards">
            <div class="col-12 col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">{{ 'app.ui.fixtures_reset.what.title'|trans }}</h3>
                    </div>
                    <div class="card-body">
                        <p>{{ 'app.ui.fixtures_reset.what.intro'|trans }}</p>
                        <ul>
                            <li>{{ 'app.ui.fixtures_reset.what.data'|trans }}</li>
                            <li>{{ 'app.ui.fixtures_reset.what.lost'|trans }}</li>
                            <li>{{ 'app.ui.fixtures_reset.what.schedule'|trans }}</li>
                        </ul>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">
                        <h3 class="card-title">{{ 'app.ui.fixtures_reset.effects.title'|trans }}</h3>
                    </div>
                    <div class="card-body">
                        <ul>
                            <li>{{ 'app.ui.fixtures_reset.effects.logout'|trans }}</li>
                            <li>{{ 'app.ui.fixtures_reset.effects.ids'|trans }}</li>
                            <li>{{ 'app.ui.fixtures_reset.effects.mcp'|trans }}</li>
                            <li>{{ 'app.ui.fixtures_reset.effects.duration'|trans }}</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card card-borderless">
                    <div class="card-status-top bg-danger"></div>
                    <div class="card-body">
                        <h3 class="card-title">{{ 'app.ui.fixtures_reset.action.title'|trans }}</h3>

                        {% if running %}
                            <div class="alert alert-warning" role="alert">
                                {{ 'app.ui.fixtures_reset.action.running'|trans }}
                            </div>
                        {% endif %}

                        <p class="text-secondary">{{ 'app.ui.fixtures_reset.action.login'|trans }}</p>

                        <form
                            method="post"
                            action="{{ path('app_admin_fixtures_reset_run') }}"
                            data-confirm="{{ 'app.ui.fixtures_reset.action.confirm'|trans }}"
                            onsubmit="if (!confirm(this.dataset.confirm)) { return false; } const button = this.querySelector('button'); button.disabled = true; button.querySelector('[data-label]').textContent = button.dataset.pending; button.querySelector('.spinner-border').classList.remove('d-none'); return true;"
                        >
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('app_fixtures_reset') }}">
                            <button
                                type="submit"
                                class="btn btn-danger w-100"
                                data-pending="{{ 'app.ui.fixtures_reset.action.pending'|trans }}"
                                {{ running ? 'disabled' }}
                                {{ sylius_test_html_attribute('fixtures-reset-button') }}
                            >
                                <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                                {{ ux_icon('tabler:restore', { class: 'icon' }) }}
                                <span data-label>{{ 'app.ui.fixtures_reset.action.submit'|trans }}</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
