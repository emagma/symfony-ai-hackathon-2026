# The shop - served by the shared php image (compose.yaml), on :80.
{
	frankenphp
	auto_https off
}

:80 {
	log {
		# Redact the authorization query parameter
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root * /srv/app/apps/shop/public
	encode zstd br gzip
	php_server
}
