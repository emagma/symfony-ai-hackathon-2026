# Non-secret defaults. The compose overlay (compose.chat.yaml) provides the
# real values - API keys included - from docker/.env.
APP_ENV=dev
APP_SECRET=testchat-dev-only-not-a-secret
TESTCHAT_PUBLIC_URL=http://localhost:8090
TESTCHAT_MCP_URL=http://mcp-server/_mcp
# NO API KEYS HERE: this file is committed, and compose sets the variables
# anyway (a real environment variable always wins over a .env file). They go in
# .project.local.ini, [infrastructure.ai.<provider>] api_key, then
# `castor init:env && castor chat:up`.
TESTCHAT_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode
