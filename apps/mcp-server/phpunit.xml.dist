<?xml version="1.0" encoding="UTF-8"?>

<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="var/cache/.phpunit.cache"
         colors="true"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
>
    <php>
        <ini name="error_reporting" value="-1" />
        <!-- Both: Dotenv reads $_SERVER first, KernelTestCase $_ENV. -->
        <server name="APP_ENV" value="test" force="true" />
        <env name="APP_ENV" value="test" force="true" />
        <server name="APP_DEBUG" value="0" force="true" />
        <env name="APP_DEBUG" value="0" force="true" />
        <!-- Not forced: a run may set the shop extensions. -->
        <env name="MCP_SHOP_EXTENSIONS" value="" />
        <server name="KERNEL_CLASS" value="Emagma\SyliusMcpServer\Kernel" force="true" />
    </php>
    <testsuites>
        <testsuite name="Conformance">
            <directory>tests/Conformance</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Functional">
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
