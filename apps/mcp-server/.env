# Committed defaults for a local run; docker compose overrides them.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=not-a-secret-outside-the-stack
TRUSTED_PROXIES=127.0.0.1
DEFAULT_URI=http://localhost:8081
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# The server's own database: the audit and the other tables of its bundles.
DATABASE_URL="mysql://mcp:mcp@127.0.0.1:3306/mcp_server_dev?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> emagma/mcp-sylius-bundle ###
# Trailing slash: the paths are relative to it.
SYLIUS_API_URL=http://localhost/api/v2/admin/
MCP_SERVICE_ACCOUNT_EMAIL=
MCP_SERVICE_ACCOUNT_PASSWORD=
MCP_DEFAULT_LOCALE=en_US
# Comma-separated, the names the installed bundles declare; empty = none.
MCP_SHOP_EXTENSIONS=
# 2.0 to 2.3, a patch may follow.
MCP_SYLIUS_VERSION=2.3
###< emagma/mcp-sylius-bundle ###

###> emagma/mcp-auth-bundle ###
# The issuer as the remote client reaches it (the tunnel URL under `castor tunnel:up`).
MCP_AUTH_ISSUER_URL=http://keycloak:8085/realms/sylius
###< emagma/mcp-auth-bundle ###

###> emagma/mcp-auth-keycloak-bundle ###
# The same realm's userinfo endpoint as the server reaches it.
MCP_AUTH_USERINFO_URL=http://keycloak:8085/realms/sylius/protocol/openid-connect/userinfo
# The audience a token must carry (a mapper on the realm's clients adds it). Empty accepts any token of
# the realm: set it once the realm of the deployment hands the audience out.
MCP_AUTH_AUDIENCE=
###< emagma/mcp-auth-keycloak-bundle ###

###> emagma/mcp-tasks-bundle ###
# The OAuth client that lets the worker run a background task with the rights of the user who launched it
# (offline access, consented once). Empty: start_task cannot hand out a working link. Set by compose.
MCP_TASKS_AUTHORIZE_URL=
MCP_TASKS_TOKEN_URL=
MCP_TASKS_CLIENT_ID=
MCP_TASKS_CLIENT_SECRET=
MCP_TASKS_REDIRECT_URI=
###< emagma/mcp-tasks-bundle ###

###> symfony/ai-anthropic-platform ###
# The model provider of what the SERVER asks a model itself (background tools and agents), not of the chat
# that calls it. Empty: those tools answer that no model is configured. From .project.local.ini through compose.
MCP_AI_ANTHROPIC_API_KEY=
###< symfony/ai-anthropic-platform ###

###> symfony/mailer ###
# Where the alerts of the background agents are sent from; Mailpit in the dev stack (compose).
MAILER_DSN=null://null
###< symfony/mailer ###

###> emagma/mcp-agents-bundle ###
# Who receives the alerts of the background agents (comma-separated). Empty: the journal only.
MCP_AGENT_ALERT_EMAIL=
###< emagma/mcp-agents-bundle ###

###> emagma/mcp-skills-bundle ###
# The skills of the business, one folder per skill with its SKILL.md: what list_skills and get_skill serve.
MCP_SKILLS_DIR=%kernel.project_dir%/../../skills
###< emagma/mcp-skills-bundle ###

###> emagma/mcp-knowledge-bundle ###
# The procedures of the business, as Markdown files: what search_knowledge reads.
MCP_KNOWLEDGE_DIR=%kernel.project_dir%/../../knowledge
###< emagma/mcp-knowledge-bundle ###

###> emagma/mcp-sylius-events-bundle ###
# The secret shared with the shop's event plugin, which signs the webhooks of /webhook/sylius.
MCP_EVENT_WEBHOOK_SECRET=
###< emagma/mcp-sylius-events-bundle ###
