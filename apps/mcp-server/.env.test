KERNEL_CLASS='Emagma\SyliusMcpServer\Kernel'
APP_SECRET='$ecretf0rt3st'
DEFAULT_URI=http://mcp.test
# No database server in CI.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
SYLIUS_API_URL=http://shop.test/api/v2/admin/
MCP_SERVICE_ACCOUNT_EMAIL=mcp@test
MCP_SERVICE_ACCOUNT_PASSWORD=test
MCP_SHOP_EXTENSIONS=
MCP_SYLIUS_VERSION=2.3
MCP_AUTH_ISSUER_URL=http://keycloak.test/realms/sylius
MCP_AUTH_USERINFO_URL=http://keycloak.test/realms/sylius/protocol/openid-connect/userinfo
# The dev stack exports APP_SECRET empty, the fallback of emagma_mcp_core.privacy.secret.
MCP_PRIVACY_SECRET=not-a-secret-outside-the-stack
# The secret the functional suite signs its webhooks of /webhook/sylius with.
MCP_EVENT_WEBHOOK_SECRET=webhook-test-secret
