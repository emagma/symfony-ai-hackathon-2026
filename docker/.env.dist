# Generated from .project.ini by bin/resolve-env.sh - run `castor init:env`.
# This .dist is documentation only: it mirrors the generator's output and key
# order. The real docker/.env is git-ignored and holds real secrets.

# -- project --------------------------------------------------------------
PROJECT_ENV=dev
SHOP_DOMAIN_NAME=shop.sylius-assistant-stack.emagma
SHOP_DEFAULT_LOCALE=en_US
SHOP_APP_ENV=prod
SHOP_APP_DEBUG=0
SHOP_APP_SECRET=CHANGE_ME

# -- shop database (the server also hosts the MCP server's database) ------
SHOP_DATABASE_IMAGE=mysql:8.4
SHOP_DATABASE_NAME=shop_dev
SHOP_DATABASE_USER=shop
SHOP_DATABASE_PASSWORD=CHANGE_ME
SHOP_DATABASE_ROOT_PASSWORD=CHANGE_ME

# -- mcp-server -----------------------------------------------------------
MCP_APP_SECRET=<generated>
MCP_SERVER_PORT=8081
# The one Sylius admin the MCP server calls the Admin API with; created in the
# shop by `castor shop:db`. Password generated on first resolve.
MCP_SERVICE_ACCOUNT_EMAIL=mcp-server@sylius-assistant-stack.emagma
MCP_SERVICE_ACCOUNT_PASSWORD=CHANGE_ME
MCP_DATABASE_NAME=mcp_server_dev
MCP_DATABASE_USER=mcp
MCP_DATABASE_PASSWORD=CHANGE_ME

# -- chat -----------------------------------------------------------------
CHAT_PORT=8090

# -- compose --------------------------------------------------------------
DOCKER_REGISTRY=emagma-agent-backend
PROJECT_NAME=sylius-assistant-stack
COMPOSE_FILE=compose.yaml:compose.dev.yaml:compose.chat.yaml
COMPOSER_AUTH_JSON=~/.composer/auth.json

# -- container user (matches the host, for bind-mount permissions) --------
PROJECT_USER=app
PROJECT_USER_ID=1000
PROJECT_GROUP_ID=1000

# -- php image ------------------------------------------------------------
PHP_VERSION=8.4
PHP_EXTENSIONS="openssl opcache imagick exif gd intl pdo_mysql sysvsem uuid zip"

# -- mailpit --------------------------------------------------------------
SHOP_MAILER_DSN=smtp://mailpit:1025

# -- chat LLM API keys: asked of the developer, never generated -----------
TESTCHAT_OPENAI_API_KEY=
TESTCHAT_ANTHROPIC_API_KEY=
TESTCHAT_MISTRAL_API_KEY=
TESTCHAT_QWEN_API_KEY=
TESTCHAT_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode

# -- tunnel ---------------------------------------------------------------
# NOT written by resolve-env.sh. `castor tunnel:up` appends a managed block at
# the end of the real docker/.env (and `tunnel:down` removes it); a re-run of
# `castor init:env` regenerates the file and so drops the tunnel:
#
#   # -- tunnel (managed by `castor tunnel:up` / `tunnel:down`, dropped by `init:env`) --
#   COMPOSE_FILE=compose.yaml:compose.dev.yaml:compose.chat.yaml:compose.tunnel.yaml
#   TUNNEL_MCP_URL=https://<random>.trycloudflare.com
#   TUNNEL_KEYCLOAK_URL=https://<random>.trycloudflare.com
#   # -- /tunnel --
